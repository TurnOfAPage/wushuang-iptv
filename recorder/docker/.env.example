# 无双IPTV录像工具 · Docker 部署环境变量（复制为 .env 后按需修改）
# 与 iptv-wan（19999，公网鉴权转发）互不影响；本服务仅限局域网，禁止映射公网！

# 容器时区（必须与 NAS/宿主机本地时区一致，否则预约时间偏移；alpine 默认 UTC）
TZ=Asia/Shanghai
# NAS 有线网口 IP（接入 IPTV 专网/桥接网络的那个口，与 wan 的 IPTV_IFACE 一致）
IPTV_IFACE=192.168.2.84
# 监听端口（局域网直播转发+录像点播；避开 wan 的 19999）
IPTV_PORT=9999
# 频道文件（容器内路径；放在 IPTV_DATA_DIR 下，主工具 verify 产物）
IPTV_CHANNELS=/data/zj-telecom-verified.m3u
# NAS 上频道文件所在目录（只读挂载到 /data）
IPTV_DATA_DIR=/volume1/家庭共享盘/iptv
# NAS 上录像目录（读写挂载到 /rec；建议独立子目录，便于配额/备份）
IPTV_RECORD_DIR=/volume1/家庭共享盘/iptv/rec
# 录像配额 GB（超出按最旧已完成自动清理；0=不限）；每小时每频道约 1~4 GB（高清），4K 15~22
IPTV_QUOTA_GB=100
# 同时录制路数上限（光猫可能限速加组，勿贪多）
IPTV_MAX_CONCURRENT=2
# 预约提前/延后余量（秒）
IPTV_PAD_BEFORE=60
IPTV_PAD_AFTER=120
# 重启后错过计划：skip 标记错过 / remainder 续录剩余
IPTV_MISSED=skip
